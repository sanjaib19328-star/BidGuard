# Application Settings
PROJECT_NAME="BidGuard AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL with asyncpg)
DATABASE_URL="postgresql+asyncpg://bidguard:bidguard@localhost:5433/bidguard"
DATABASE_ECHO=false

# Security / JWT (Placeholder for Phase 1.3)
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

# Hugging Face AI Stack Configuration
DOCUMENT_MODEL="microsoft/layoutlmv3-base"
OCR_MODEL="microsoft/trocr-small-printed"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
LLM_MODEL="Qwen/Qwen2.5-1.5B-Instruct"
HUGGINGFACE_API_KEY=""
AI_DEVICE="cpu"
ENABLE_LOCAL_AI_MODELS=true
